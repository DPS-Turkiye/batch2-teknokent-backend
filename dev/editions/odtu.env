# Overrides for the local ODTÜ (b) stack; up.sh appends these to a copy of .env to make .env.odtu.
# No secrets here: everything secret still comes from your own .env.
APP_EDITION=ODTU
# Sign in with the persona picker at http://localhost:3100/login/odtu/dev (local only).
INSTITUTION_LOGIN_DEV_STUB=true
OTG_LOGIN_ENABLED=false
# (b) never writes to S3. With no bucket the backend runs with storage unconfigured until MinIO (E5) lands.
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# No meeting bot in (b) until Lane V's setup is approved (T11).
MEETING_TRANSCRIPT_BOT_ENABLED=false
MEETING_PROVIDER_BASE_URL=
MEETING_PROVIDER_API_KEY=
MATCHING_PGVECTOR_ENABLED=false
REALTIME_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
DOCUMENTS_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
