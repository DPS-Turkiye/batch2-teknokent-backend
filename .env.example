# Spring (profiles)
SPRING_PROFILES_ACTIVE=dev

# Server
SERVER_PORT=8080
APP_PORT=8080

# HTTP Basic auth (API + docs)
SECURITY_USERNAME=teknokent
SECURITY_PASSWORD=change-me

# Database
DATABASE_NAME=db
DATABASE_USERNAME=teknokent
DATABASE_PASSWORD=change-me
DATABASE_PORT=5432

# AI provider called directly by Spring Boot for profile structuring and embeddings.
# Choose "openai" or "openrouter". Never commit a real key.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenRouter configuration (used when AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_APP_NAME=TeamTNT PDF Parse and Match Lab

# PDFBox extracts text inside Spring Boot. Tesseract handles scanned pages locally.
TESSERACT_EXECUTABLE=tesseract
TESSERACT_LANGUAGES=tur+eng
TESSERACT_TIMEOUT_SECONDS=45
# Cache confirmed mentor CV embeddings in PostgreSQL and use cosine retrieval
# before the existing semantic ranking stage.
MATCHING_PGVECTOR_ENABLED=true

# Meeting assistant provider
MEETING_PROVIDER_BASE_URL=
MEETING_PROVIDER_API_KEY=
