# Spring (profiles)
SPRING_PROFILES_ACTIVE=dev

# Server
SERVER_PORT=8080
APP_PORT=8080

# HTTP Basic auth (API + docs)
SECURITY_USERNAME=teknokent
SECURITY_PASSWORD=change-me

# Database
DATABASE_HOST=localhost
DATABASE_NAME=db
DATABASE_USERNAME=teknokent
DATABASE_PASSWORD=change-me
DATABASE_PORT=5432

# AI provider called directly by Spring Boot for profile structuring and embeddings.
# Choose "openai" or "openrouter". Never commit a real key.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenRouter configuration (used when AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_REPORT_MODEL=google/gemini-3-flash-preview
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_APP_NAME=TeamTNT PDF Parse and Match Lab

# PDFBox extracts text inside Spring Boot. Tesseract handles scanned pages locally.
TESSERACT_EXECUTABLE=tesseract
TESSERACT_LANGUAGES=tur+eng
TESSERACT_TIMEOUT_SECONDS=45
# Cache confirmed mentor CV embeddings in PostgreSQL and use cosine retrieval
# before the existing semantic ranking stage.
MATCHING_PGVECTOR_ENABLED=true

# Meeting assistant provider
MEETING_PROVIDER_BASE_URL=
MEETING_PROVIDER_API_KEY=

# Transcript bot: joins Meet near start when transcribe was requested.
# Tests force this off in src/test/resources/application.yml.
MEETING_TRANSCRIPT_BOT_ENABLED=true
MEETING_TRANSCRIPT_BOT_INTERVAL_MS=30000

# Local Redis (ElastiCache in AWS). No password in compose; set REDIS_PASSWORD in prod.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

REALTIME_TOKEN_SECRET=change-me
REALTIME_TOKEN_TTL_SECONDS=60
REALTIME_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://menton.com.tr,https://www.menton.com.tr,https://*.amplifyapp.com
# Browser uploads hit the API directly (Amplify blocks large proxy bodies).
DOCUMENTS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://menton.com.tr,https://www.menton.com.tr,https://*.amplifyapp.com
# Live note document in Redis: idle expiry, and the window in which a single
# client may seed an empty note from the PostgreSQL snapshot.
REALTIME_DOCUMENT_TTL_HOURS=12
REALTIME_SEED_LOCK_SECONDS=30

# Firebase Auth (token verification in a later slice). Do not commit the JSON key.
# Same two variables locally and in AWS SSM. Do not use a Windows file path in SSM.
FIREBASE_PROJECT_ID=
# Paste the service-account JSON as a single line (no line breaks).
FIREBASE_CREDENTIALS_JSON=

AWS_REGION=eu-central-1
AWS_S3_BUCKET=teknokent-batch2-assets-126942145699
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
