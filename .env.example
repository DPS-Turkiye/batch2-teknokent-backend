# Spring (profiles)
SPRING_PROFILES_ACTIVE=dev

# Server
SERVER_PORT=8080
APP_PORT=8080
# Swagger UI at /api/docs. Leave unset (off) in production: the API map is public when on.
SWAGGER_ENABLED=true

# HTTP Basic auth (API + docs)
SECURITY_USERNAME=teknokent
SECURITY_PASSWORD=change-me

# Database
DATABASE_HOST=localhost
DATABASE_NAME=db
DATABASE_USERNAME=teknokent
DATABASE_PASSWORD=change-me
DATABASE_PORT=5432
# Connections per app instance. Keep (instances × this) under the database's connection limit.
DATABASE_POOL_SIZE=20

# AI provider called directly by Spring Boot for profile structuring and embeddings.
# Choose "openai" or "openrouter". Never commit a real key.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenRouter configuration (used when AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_REPORT_MODEL=google/gemini-3-flash-preview
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_APP_NAME=TeamTNT PDF Parse and Match Lab

# PDFBox extracts text inside Spring Boot. Tesseract handles scanned pages locally.
TESSERACT_EXECUTABLE=tesseract
TESSERACT_LANGUAGES=tur+eng
TESSERACT_TIMEOUT_SECONDS=45
# Cache confirmed mentor CV embeddings in PostgreSQL and use cosine retrieval
# before the existing semantic ranking stage.
MATCHING_PGVECTOR_ENABLED=true

# Meeting assistant provider
MEETING_PROVIDER_BASE_URL=
MEETING_PROVIDER_API_KEY=

# Transcript bot: joins Meet near start when transcribe was requested.
# Tests force this off in src/test/resources/application.yml.
MEETING_TRANSCRIPT_BOT_ENABLED=true
MEETING_TRANSCRIPT_BOT_INTERVAL_MS=30000

# Local Redis (ElastiCache in AWS). No password in compose; set REDIS_PASSWORD in prod.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

REALTIME_TOKEN_SECRET=change-me
REALTIME_TOKEN_TTL_SECONDS=60
REALTIME_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://menton.com.tr,https://www.menton.com.tr
# Browser uploads hit the API directly (Amplify blocks large proxy bodies).
DOCUMENTS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://menton.com.tr,https://www.menton.com.tr
# Live note document in Redis: idle expiry, and the window in which a single
# client may seed an empty note from the PostgreSQL snapshot.
REALTIME_DOCUMENT_TTL_HOURS=12
REALTIME_SEED_LOCK_SECONDS=30

# Firebase Auth (token verification in a later slice). Do not commit the JSON key.
# Same two variables locally and in AWS SSM. Do not use a Windows file path in SSM.
FIREBASE_PROJECT_ID=
# Paste the service-account JSON as a single line (no line breaks).
FIREBASE_CREDENTIALS_JSON=

# Which deployment this backend is: TEKNOKENT (default; startup mentoring) or ODTU (office hours + İŞKUR peer
# mentoring). Each edition answers 404 for the other one's endpoints. Leave it out rather than blank: a blank
# value stops the app at startup.
APP_EDITION=TEKNOKENT

# ODTÜ sign-in. Local development only: "true" replaces ODTÜ's login with a persona picker
# (frontend /login/odtu/dev). Never set it on a shared or production server.
INSTITUTION_LOGIN_DEV_STUB=false

# "OTG ile giriş yap" (ODTÜ TEKNOKENT Girişimcilik). Off unless true. The redirect URI must be one OTG has
# registered, exactly (locally http://localhost:3000/auth/otg/callback). The client secret is server-side only:
# never in the frontend, never in git; ask for it, don't copy it from a chat.
OTG_LOGIN_ENABLED=false
OTG_ISSUER=https://girisimcilik.odtuteknokent.com.tr/auth/v1
OTG_USERINFO_URL=https://girisimcilik.odtuteknokent.com.tr/api/oauth/userinfo
OTG_CLIENT_ID=
OTG_CLIENT_SECRET=
OTG_REDIRECT_URI=

# Web push goes through the same Firebase service account; without it pushes are skipped.
# Reminder job: meetings 30 minutes before start, task deadlines the day before.
NOTIFICATION_REMINDERS_ENABLED=true
NOTIFICATION_REMINDERS_INTERVAL_MS=60000

AWS_REGION=eu-central-1
AWS_S3_BUCKET=teknokent-batch2-assets-126942145699
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Amazon SES sender for mentor request emails. Leave empty to send no email.
# The domain must be verified in SES (eu-central-1).
MAIL_FROM=
APP_PUBLIC_URL=https://menton.com.tr

# Office hours from Moodle (LTI 1.3). Leave LTI_PLATFORM_ISSUER empty to keep LTI off.
# Values come from the tool registration in Moodle (Site administration > Plugins > External tool > Manage tools).
# Local Moodle: `docker compose --profile moodle up` prints these values (see dev/moodle/README.md). The JWKS URL
# is fetched by this backend over the compose network: http://moodle:8080/mod/lti/certs.php.
LTI_PLATFORM_ISSUER=
LTI_CLIENT_ID=
# Comma-separated; one per registration.
LTI_DEPLOYMENT_IDS=
LTI_PLATFORM_AUTH_URL=
LTI_PLATFORM_JWKS_URL=
# The frontend URL Moodle posts the launch to, e.g. http://localhost:3000/lti/launch
LTI_TOOL_LAUNCH_URL=
# PKCS#8 RSA private key (PEM, one line is fine). Empty makes a throwaway key at start-up.
LTI_TOOL_PRIVATE_KEY=
