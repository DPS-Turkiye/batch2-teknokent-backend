# Spring (profiles)
SPRING_PROFILES_ACTIVE=dev

# Server
SERVER_PORT=8080
APP_PORT=8080

# Database
DATABASE_NAME=db
DATABASE_USERNAME=teknokent
DATABASE_PASSWORD=change-me
DATABASE_PORT=5433

# Prototype HTTP Basic authentication
SECURITY_USERNAME=teknokent
SECURITY_PASSWORD=change-me

# AI provider used by the PDF parsing and mentor-matching prototypes.
# Choose "openai" or "openrouter". Never commit a real key.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# OpenRouter configuration (used when AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional: native, cloudflare-ai, or mistral-ocr. Empty uses OpenRouter's default.
OPENROUTER_PDF_ENGINE=
OPENROUTER_APP_NAME=TeamTNT PDF Parse and Match Lab

# Local addresses of the Python parsing/matching tools. Docker reaches the Mac host
# through host.docker.internal.
PROFILE_PARSER_URL=http://host.docker.internal:8765
PROFILE_MATCHER_URL=http://host.docker.internal:8766
# Cache confirmed mentor CV embeddings in PostgreSQL and use cosine retrieval
# before the existing semantic ranking stage.
MATCHING_PGVECTOR_ENABLED=true
