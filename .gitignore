# Firebase Admin SDK private keys. Never commit these.
*firebase-adminsdk*.json
*-firebase-adminsdk-*.json

# iCloud sync spawns byte-identical copies ("file 2.sql", "file 3.ts").
# Two migrations at one version stop Flyway from starting, and a stray
# `git add -A` has committed these before. Never track them.
* [0-9].*
